package menucalsulator;

import java.util.Scanner;

/**
 *
 * @author KIIT
 */
public class Menucalsulator {

    /**
     * @param args the command line arguments
     */
    public static void main(String[] args) {
        float a,b;
        String m;
        Scanner s= new Scanner(System.in);
        System.out.println("Enter two number");
        a=s.nextFloat();
        b=s.nextFloat();
        s.nextLine();
        System.out.println("MENU  1.Add  2.Subtract  3.Multiply  4.Division");
        m=s.nextLine();
        switch(m){
            case "Add": System.out.println("Additon of two number "+(a+b));
            break;
            case "Subtract": System.out.println("Subtraction of two number "+(a-b));
            break;
            case "Multiply": System.out.println("Multiply of two number "+(a*b));
            break;
            case "Divide": System.out.println("Division of two number "+(a/b));
            break;
            default: System.out.println("Invalid key");
            break;
        }
        
    }
    
}
